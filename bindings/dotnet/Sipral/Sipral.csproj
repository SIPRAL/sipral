<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- the printed binding answers with a string? where C answers with a
         null pointer, so the nullable annotations have to mean something -->
    <Nullable>enable</Nullable>
    <PackageId>Sipral</PackageId>
    <Version>1.1.0</Version>
    <Authors>Sytek</Authors>
    <Copyright>Copyright (c) 2026 Sytek</Copyright>
    <Description>Sipral - Session Initiation Protocol Rust Audio Layer. The .NET binding over the C ABI, with the native library for Windows, macOS and Linux inside the package. Licensed under AGPL-3.0-only, or under the Sipral commercial licence for closed-source products: https://sipral.org/terms/</Description>
    <!-- the AGPL arm alone: nuget.org takes only licence identifiers the OSI
         or the FSF approved, so the commercial arm's LicenseRef- cannot be
         written here; LICENSING.md, linked from the README, states both -->
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
    <PackageProjectUrl>https://sipral.org</PackageProjectUrl>
    <RepositoryUrl>https://github.com/SIPRAL/sipral</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>sip;voip;rtp;telephony;softphone</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="icon.png" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
