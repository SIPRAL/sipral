<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- A self-managed PhoneAccount needs this and nothing more: the
         application draws its own call screens, and the framework only
         arbitrates between it and every other calling application. -->
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
    <!-- SipralCallService, the call's foreground service: phoneCall, which
         MANAGE_OWN_CALLS allows, and microphone, which also needs the
         application's own RECORD_AUDIO granted. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- androidx.core:core-telecom (CoreTelecomPlatform) merges in its own
         ConnectionService (used below Android 14), a receiver for the
         microphone's mute, and BLUETOOTH_CONNECT and MODIFY_AUDIO_SETTINGS:
         BLUETOOTH_CONNECT, a runtime permission from Android 12, lets it
         name every connected headset rather than only the active one. -->

    <application>
        <!-- Merged into the application that uses this library. Only the
             telecom framework can bind to it. -->
        <service
            android:name="org.sipral.android.telecom.SipralConnectionService"
            android:exported="true"
            android:permission="android.permission.BIND_TELECOM_CONNECTION_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.ConnectionService" />
            </intent-filter>
        </service>
        <service
            android:name="org.sipral.android.telecom.SipralCallService"
            android:exported="false"
            android:foregroundServiceType="phoneCall|microphone" />
    </application>
</manifest>
