<!--
SPDX-License-Identifier: AGPL-3.0-only OR LicenseRef-Sipral-Commercial
Copyright (c) 2026 Sytek

The lab's numbers on FusionPBX, written into its own dialplan table
(v_dialplans.dialplan_xml) by setup.sh, in the domain's context, ahead of
every dialplan FusionPBX installs by itself. The same numbers, and for the
same reasons, as interop/freeswitch/lab.xml: 9000 a tone bridged through a
loopback leg so a transfer has somebody to hand over, 9001 a different tone
for a transfer to land on, 9003 a digit read and sent straight back -- then
silence until the caller hangs up, since send_dtmf only queues the digit and a
channel hung up at once never sends it -- 9005
the tone again with DTLS-SRTP required, 9004 the same with SDES required, 9008
an echo for G.729 offered alone (setup.sh adds G.729 to the codecs the
profile accepts), 9013 the digit by SIP INFO both ways, and 9007 a message
left for the caller's mailbox: MESSAGE_WAITING, as FusionPBX's voicemail
fires it, once the caller hangs up (setup.sh says how the subscription is
answered). The
echo is FusionPBX's own, *9196,
which it installs in every domain.
CONTEXT is replaced by the domain's name when the row is written.
-->
<extension name="sipral_lab" continue="false">
  <condition field="destination_number" expression="^9000$">
    <action application="bridge" data="loopback/9002/CONTEXT"/>
  </condition>
</extension>
<extension name="sipral_lab_media" continue="false">
  <condition field="destination_number" expression="^9002$">
    <action application="answer"/>
    <action application="playback" data="tone_stream://%(1200,600,350,440);loops=-1"/>
    <action application="hangup"/>
  </condition>
</extension>
<extension name="sipral_lab_transfer" continue="false">
  <condition field="destination_number" expression="^9001$">
    <action application="answer"/>
    <action application="playback" data="tone_stream://%(60000,0,480,620)"/>
    <action application="hangup"/>
  </condition>
</extension>
<extension name="sipral_lab_dtmf" continue="false">
  <condition field="destination_number" expression="^9003$">
    <action application="answer"/>
    <action application="read" data="1 1 silence_stream://1 digit 5000 #"/>
    <action application="send_dtmf" data="${digit}"/>
    <action application="playback" data="silence_stream://-1"/>
  </condition>
</extension>
<extension name="sipral_lab_dtls" continue="false">
  <condition field="destination_number" expression="^9005$">
    <action application="set" data="rtp_secure_media=mandatory"/>
    <action application="answer"/>
    <action application="playback" data="tone_stream://%(1200,600,350,440);loops=-1"/>
    <action application="hangup"/>
  </condition>
</extension>
<extension name="sipral_lab_dtmf_info" continue="false">
  <condition field="destination_number" expression="^9013$">
    <action application="set" data="dtmf_type=info"/>
    <action application="answer"/>
    <action application="read" data="1 1 silence_stream://1 digit 5000 #"/>
    <action application="send_dtmf" data="${digit}"/>
    <action application="playback" data="silence_stream://-1"/>
  </condition>
</extension>
<extension name="sipral_lab_srtp" continue="false">
  <condition field="destination_number" expression="^9004$">
    <action application="set" data="rtp_secure_media=mandatory"/>
    <action application="answer"/>
    <action application="playback" data="tone_stream://%(1200,600,350,440);loops=-1"/>
    <action application="hangup"/>
  </condition>
</extension>
<extension name="sipral_lab_g729" continue="false">
  <condition field="destination_number" expression="^9008$">
    <action application="answer"/>
    <action application="echo"/>
  </condition>
</extension>
<extension name="sipral_lab_mwi" continue="false">
  <condition field="destination_number" expression="^9007$">
    <action application="set" data="api_hangup_hook=lua ~local e = freeswitch.Event(&quot;MESSAGE_WAITING&quot;); e:addHeader(&quot;MWI-Messages-Waiting&quot;, &quot;yes&quot;); e:addHeader(&quot;MWI-Message-Account&quot;, &quot;sip:${sip_from_user}@${sip_from_host}&quot;); e:addHeader(&quot;MWI-Voice-Message&quot;, &quot;1/0 (0/0)&quot;); e:addHeader(&quot;Sofia-Profile&quot;, &quot;internal&quot;); e:fire()"/>
    <action application="answer"/>
    <action application="playback" data="silence_stream://-1"/>
  </condition>
</extension>
